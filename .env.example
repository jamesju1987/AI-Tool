# ---------------------------------------------------------------- required
DOMAIN=aitoolbox.example.com
SITE_URL=https://aitoolbox.example.com
POSTGRES_PASSWORD=change-me-long-random
# Shared secret between the worker and the site (openssl rand -hex 32)
REVALIDATE_SECRET=change-me
# Local development only (docker-compose builds its own DATABASE_URL):
DATABASE_URL=postgres://postgres@127.0.0.1:5432/aitoolbox

# ---------------------------------------------------------------- site
SITE_NAME_ZH=AI 工具箱
SITE_NAME_EN=AI Toolbox
# Comma-separated IPs allowed to open /admin (empty = anyone may reach the login page)
ADMIN_IP_ALLOWLIST=
ADMIN_SESSION_HOURS=12

# ---------------------------------------------------------------- AI models
# Check your keys with: npm run ai:check
# Without any key the pipeline runs offline: rule-based drafts, everything goes to review.

# Jev (ranking + intake scoring). Either a TypeSafe key (direct) …
TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# … or an OpenRouter key (also used for the chat model below).
OPENROUTER_API_KEY=
# Defaults: jev-latest with TYPESAFE_API_KEY, typesafe/jev-1.13 via OpenRouter
JEV_MODEL=
# OpenRouter only: decisions → /api/alpha/decisions, systemone → /api/v1/systemone
JEV_SURFACE=decisions

# Chat model for bilingual extraction — any OpenAI-compatible API.
# Default: OpenRouter with OPENROUTER_API_KEY. To use DeepSeek directly instead:
#   LLM_BASE_URL=https://api.deepseek.com/v1  LLM_API_KEY=sk-...  LLM_MODEL=deepseek-chat
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash
# Optional, enables vector duplicate detection (embeddings model on the same API)
EMBEDDING_MODEL=
# Force offline heuristics even with keys (true/false)
MOCK_AI=

# ---------------------------------------------------------------- sources
PRODUCTHUNT_TOKEN=
GITHUB_TOKEN=
FETCH_USER_AGENT=AIToolboxBot/1.0 (+https://aitoolbox.example.com/methodology)

# ---------------------------------------------------------------- safety & alerts
# Google Safe Browsing v4 key — flags malicious outbound links during patrol
SAFE_BROWSING_API_KEY=
# Feishu / WeCom / DingTalk / Slack incoming webhook for the 07:00 digest and job failures
NOTIFY_WEBHOOK_URL=
# Time zone for the cron schedule
TZ_SCHEDULE=Asia/Shanghai
PAGE_CACHE_TTL_MS=120000
